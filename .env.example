# PostgreSQL Connection String (Neon)
# Get this from your Neon project dashboard -> Connection Details
# Example: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Flask Secret Key for sessions
# Generate a random string for production
SECRET_KEY=06e4b4738ab81f94277a7216b5e79fb24b339f28a6a131391d8d6f8f0a295dc1

# Encryption key for patient data at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-generated-key

# Gmail SMTP Configuration for Password Resets
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Initial Admin Email
ADMIN_EMAIL=admin@example.com

# Password Reset Expiry in minutes
PASSWORD_RESET_EXPIRY_MINUTES=30

# Rate limits
# Leave enabled for login protection; default app limits are intentionally generous for local dashboards.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULTS=100000 per day,10000 per hour

# Redis (used for background job queue; optional for local dev)
REDIS_URL=redis://localhost:6379/0

# Scheduler (billing/report cron jobs) — disable for local dev
SCHEDULER_ENABLED=false
